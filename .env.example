# ==============================================================================
# UPER GIRL — ENVIRONMENT CONFIGURATION (SUPABASE CLOUD)
# ==============================================================================

# 1. Supabase Cloud Credentials (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Supabase Direct Database Connection (From Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 3. Backend API Port
PORT=5000
NODE_ENV=development

# 4. Google OAuth Credentials (Optional / for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
