rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Root Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Authentication & Authorization Helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (
          request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['admin@rafik.app', 'support@rafik.app', 'operations@rafik.app']
        )
      );
    }

    function isApprovedDriver() {
      return isAuthenticated() && (
        (request.auth.token.role == 'driver' && request.auth.token.approved == true) ||
        (
          exists(/databases/$(database)/documents/drivers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time + duration.value(1, 'm');
    }

    // ===============================================================
    // 1. Users Collection (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Client registration: Can register as 'rider' or 'driver', but never 'admin'
      // Cannot self-verify female status (gender_verified must be false)
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['rider', 'driver'] &&
        request.resource.data.gender in ['male', 'female'] &&
        request.resource.data.gender_verified == false &&
        request.resource.data.is_active == true &&
        isRecent(request.resource.data.created_at);

      // Client updates: Can update profile info, but cannot alter role, verification, or rating
      allow update: if (isOwner(userId) || isAdmin()) &&
        (
          isAdmin() ||
          (
            areImmutableFieldsUnchanged(['uid', 'role', 'gender_verified', 'rating_avg', 'created_at']) &&
            request.resource.data.uid == resource.data.uid
          )
        );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. Riders Collection (/riders/{riderId})
    // ===============================================================
    match /riders/{riderId} {
      allow read: if isOwner(riderId) || isAdmin();
      allow create, update: if isOwner(riderId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. Drivers Collection (/drivers/{driverId})
    // ===============================================================
    match /drivers/{driverId} {
      // Read: Owner, Admin, or anyone viewing approved online captains for map display
      allow read: if isAuthenticated() && (
        isOwner(driverId) ||
        isAdmin() ||
        (resource.data.status == 'approved' && resource.data.is_online == true)
      );

      // Create: Initial driver onboarding. Status forced to 'pending', wallet/trips zeroed
      allow create: if isOwner(driverId) &&
        request.resource.data.driver_id == driverId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.wallet_balance_egp == 0.0 &&
        request.resource.data.total_trips == 0 &&
        isRecent(request.resource.data.created_at);

      // Update:
      // - Admins have full maintenance access (approve/reject/suspend)
      // - Approved Drivers can ONLY update their availability flags (is_online, is_busy)
      allow update: if isAdmin() || (
        isOwner(driverId) &&
        resource.data.status == 'approved' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_online', 'is_busy', 'updated_at'])
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. Vehicles Collection (/vehicles/{driverId})
    // ===============================================================
    match /vehicles/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(driverId) || isAdmin();
    }

    // ===============================================================
    // 5. Driver Documents (/driver_documents/{driverId})
    // ===============================================================
    match /driver_documents/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow write: if isOwner(driverId) || isAdmin();

      match /items/{docType} {
        allow read: if isOwner(driverId) || isAdmin();
        // Driver can submit document metadata with 'pending' status; admin can approve/reject
        allow create, update: if (isOwner(driverId) && request.resource.data.status == 'pending') || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // 6. Rides Collection (/rides/{rideId})
    // ===============================================================
    match /rides/{rideId} {
      // Read: Rider, Assigned Driver, Candidate Approved Drivers (when requested), or Admin
      allow read: if isAuthenticated() && (
        resource.data.rider_id == request.auth.uid ||
        resource.data.driver_id == request.auth.uid ||
        (resource.data.status == 'requested' && isApprovedDriver()) ||
        isAdmin()
      );

      // Create: Rider can create a ride request with status 'requested' and unassigned driver,
      // OR Cloud Functions via Admin SDK creates it authoritatively.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.rider_id == request.auth.uid &&
          request.resource.data.status == 'requested' &&
          request.resource.data.driver_id == null &&
          request.resource.data.attempts == 0 &&
          isRecent(request.resource.data.requested_at)
        )
      );

      // Update:
      // Client updates strictly limited:
      // - Rider can cancel their unassigned/accepted ride before trip starts
      // - All other state transitions (accept, arrive, start, complete, fare calculation)
      //   MUST be performed via trusted Cloud Functions / Admin SDK
      allow update: if isAdmin() || (
        request.auth.uid == resource.data.rider_id &&
        resource.data.status in ['requested', 'accepted', 'arrived'] &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelled_by', 'cancellation_reason', 'cancelled_at'
        ])
      );

      allow delete: if isAdmin();

      // 6.1 Messages Subcollection (/rides/{rideId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/rides/$(rideId)).data.rider_id == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.driver_id == request.auth.uid ||
          isAdmin()
        );

        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/rides/$(rideId)).data.rider_id == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.driver_id == request.auth.uid
        ) && request.resource.data.sender_id == request.auth.uid &&
          isRecent(request.resource.data.created_at);

        allow update, delete: if false;
      }

      // 6.2 Security PIN Subcollection (/rides/{rideId}/security/pin_data)
      // STRICT ISOLATION: Driver clients have ZERO read/write access!
      match /security/pin_data {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/rides/$(rideId)).data.rider_id == request.auth.uid ||
          isAdmin()
        );
        allow write: if false; // Cloud Functions / Admin SDK only
      }
    }

    // ===============================================================
    // 7. Ride Offers Collection (/ride_offers/{offerId})
    // ===============================================================
    match /ride_offers/{offerId} {
      // Read: Only the assigned candidate driver or admin
      allow read: if isAuthenticated() && (
        resource.data.driver_id == request.auth.uid ||
        isAdmin()
      );

      // Offers are created, expired, and accepted exclusively by Cloud Functions
      allow write: if isAdmin();
    }

    // ===============================================================
    // 8. Ride History Collection (/ride_history/{historyId})
    // ===============================================================
    match /ride_history/{historyId} {
      allow read: if isAuthenticated() && (
        resource.data.rider_id == request.auth.uid ||
        resource.data.driver_id == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Archived strictly by Cloud Functions
    }

    // ===============================================================
    // 9. Payments Ledger Collection (/payments/{paymentId})
    // ===============================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.driver_id == request.auth.uid ||
        resource.data.rider_id == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Server-authoritative financial ledger
    }

    // ===============================================================
    // 10. Notifications Collection (/notifications/{notificationId})
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipient_id == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() &&
        resource.data.recipient_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);
      allow create, delete: if isAdmin();
    }

    // ===============================================================
    // 11. Application Settings (/app_settings/{document=**})
    // ===============================================================
    match /app_settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 12. Admin Users (/admin_users/{adminId})
    // ===============================================================
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // 13. SOS Events (/sos_events/{sosId})
    // ===============================================================
    match /sos_events/{sosId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.status == 'active' &&
        isRecent(request.resource.data.created_at);
      allow update, delete: if isAdmin();
    }

  }
}
